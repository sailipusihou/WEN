# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (DB / JSON stores / sessions) - keep out of git, ship via backup
/data/

# dev server pid file
*.pid

# newly uploaded runtime media (商品图/语音等运行期文件不纳入版本控制;
# 历史已跟踪文件保持不变, 部署时用 scp/rsync 同步 public/uploads/)
/public/uploads/aud-*
/public/uploads/voice-*

# logs
*.log
