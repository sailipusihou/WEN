# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (DB / JSON stores / sessions) - keep out of git, ship via backup
/data/

# dev server pid file
*.pid

# 运行期上传的素材（商品图 / 视频 / 语音 / AI 生成图）一律不进版本库。
#
# 此前只忽略了 aud-* / voice-*，导致 img-* / vid-* / hero-* / ai/* 仍会被
# `git add -A` 提交，服务器 `git pull` 时反复出现同名未跟踪文件冲突。
#
# 注意：这里刻意不去动「已经被跟踪」的历史文件（不做 git rm --cached）——
# 因为提交删除后，服务器执行 git pull 会把这些真实上传文件从工作区删掉，
# 导致线上图片 404。历史文件保持原样，新文件从此不再进入版本库。
/public/uploads/

# 部署脚本生成的打包产物（fast-deploy.cjs 每次部署都会先删掉再重新生成）
# 之前 public-assets.tar.gz 被误提交进版本库：9.4MB 二进制，且每次部署内容都不同，
# 白白撑大仓库、污染每次 diff。它是产物不是源码，不该跟踪。
/next-build.tar.gz
/public-assets.tar.gz

# logs
*.log
.deploy-lock-hash
.git-msg.txt
