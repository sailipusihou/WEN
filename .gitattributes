# 部署脚本必须保持 LF 换行，否则 Linux 上会报 "bad interpreter"
*.sh text eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 图片与媒体按二进制处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.webm binary
*.m4a binary

# SQLite 数据库按二进制处理
*.db binary
